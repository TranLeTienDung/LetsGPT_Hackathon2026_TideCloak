tidecloak.json
tidecloakAdapter.json
tidecloak.config.json
!tidecloak.example.json

# ---- Local database data & dumps ----
pgdata/
postgres-data/
*.dump
*.sqlite
*.sqlite3
*.db
backups/

# ---- Logs & runtime ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.seed

# ---- Test & coverage ----
coverage/
.nyc_output/
playwright-report/
test-results/

# ---- Editors & OS ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- Temp ----
tmp/
temp/
*.tmp
*.local