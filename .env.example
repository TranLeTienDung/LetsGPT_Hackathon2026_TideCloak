# ---- Postgres (docker-compose) ----
POSTGRES_USER=vault
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vault
DATABASE_URL=postgres://vault:change-me@localhost:5432/vault

# ---- API ----
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ---- TideCloak ----
# Issuer = <TideCloak base URL>/realms/<realm>
TIDECLOAK_ISSUER=http://localhost:8080/realms/myrealm
TIDECLOAK_CLIENT_ID=vault-web